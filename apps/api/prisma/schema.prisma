// SHC platform — database schema (source of truth). Built on the Primordial foundation; see docs/DECISIONS.md.
// Table/column names stay snake_case (as in the design) via @@map/@map; Prisma fields are camelCase.
// Status-like columns are plain strings, as in the design; allowed values are enforced in DTOs.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  // partialIndexes: unique system-role names (roles with agency_id NULL), DECISIONS D-022.
  previewFeatures = ["partialIndexes", "relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Agency & auth (§5.1) ───────────────────────────────

model Agency {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String   @db.VarChar(255)
  phone                  String?  @db.VarChar(20)
  email                  String?  @db.VarChar(255)
  addressLine1           String?  @map("address_line1") @db.VarChar(255)
  addressLine2           String?  @map("address_line2") @db.VarChar(255)
  town                   String?  @db.VarChar(100)
  postcode               String?  @db.VarChar(10)
  timezone               String   @default("Europe/London") @db.VarChar(50)
  /// Public careers page address: /careers/<slug>. Unset = no careers page.
  careersSlug            String?  @unique @map("careers_slug") @db.VarChar(60)
  settings               Json     @default("{}")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  jobPostings       JobPosting[]
  applications      Application[]
  users             User[]
  roles             Role[]
  staffProfiles     StaffProfile[]
  documents         Document[]
  notifications     Notification[]
  conversations     Conversation[]
  messages          Message[]
  trainingCourses   TrainingCourse[]

  @@map("agencies")
}

model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId            String    @map("agency_id") @db.Uuid
  /// Stored lower-cased. Globally unique so login needs only email + password (DECISIONS D-020).
  email               String    @unique @db.VarChar(255)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  firstName           String    @map("first_name") @db.VarChar(100)
  lastName            String    @map("last_name") @db.VarChar(100)
  phone               String?   @db.VarChar(20)
  isActive            Boolean   @default(true) @map("is_active")
  is2faEnabled        Boolean   @default(false) @map("is_2fa_enabled")
  /// Base64 of the PHI-encrypted TOTP secret (PhiContext.UserTwoFaSecret). Set by /auth/2fa/setup,
  /// only active once is_2fa_enabled is true.
  twoFaSecret         String?   @map("two_fa_secret") @db.VarChar(255)
  /// Last TOTP time step accepted — codes at or before it are refused (no replay).
  twoFaLastUsedStep   Int?      @map("two_fa_last_used_step")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(6)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  pinHash             String?   @map("pin_hash") @db.VarChar(255)
  pushToken           String?   @map("push_token")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency                  Agency                   @relation(fields: [agencyId], references: [id])
  userRoles               UserRole[]
  recoveryCodes           TwoFaRecoveryCode[]
  refreshTokens           RefreshToken[]
  staffProfile            StaffProfile?
  verifiedCredentials     StaffCredential[]        @relation("CredentialVerifiedBy")
  approvedTimeOff         StaffTimeOff[]           @relation("TimeOffApprovedBy")
  uploadedDocuments       Document[]               @relation("DocumentUploadedBy")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushDevices             PushDevice[]
  passwordResets          PasswordResetToken[]

  documentsDeleted Document[] @relation("DocumentDeletedBy")

  conversationsStarted Conversation[]            @relation("ConversationCreatedBy")
  conversations        ConversationParticipant[]
  messagesSent         Message[]                 @relation("MessageSender")

  @@index([agencyId])
  @@map("users")
  careCertificateSignOffs CareCertificateSignOff[] @relation("CareCertificateSignedOffBy")
  supervisionsLed         Supervision[] @relation("SupervisionSupervisor")
}

/// One-time 2FA backup codes (DECISIONS D-026). Only a SHA-256 hash is stored; codes carry 80 random bits.
model TwoFaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("two_fa_recovery_codes")
}

/// agency_id is NULL for built-in system roles shared by all agencies (DECISIONS D-013).
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId    String?  @map("agency_id") @db.Uuid
  name        String   @db.VarChar(50)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agency          Agency?          @relation(fields: [agencyId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([agencyId, name])
  /// Postgres treats NULLs as distinct, so the constraint above does not stop duplicate system roles.
  @@unique([name], map: "roles_system_name_key", where: raw("agency_id IS NULL"))
  @@index([agencyId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource    String  @db.VarChar(100)
  action      String  @db.VarChar(50)
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @map("token_hash") @db.VarChar(255)
  deviceInfo    String?   @map("device_info") @db.VarChar(255)
  ipAddress     String?   @map("ip_address") @db.Inet
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// rotated | logout | reuse_detected | password_changed | locked | idle | expired | inactive
  /// Only reuse of a *rotated* token signals theft (DECISIONS D-020).
  revokedReason String?   @map("revoked_reason") @db.VarChar(30)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

/// HIPAA audit log. Append-only. Deliberately has no foreign keys so entries
/// survive deletion/deactivation of the records they describe. Partitioned monthly by created_at
/// (raw SQL migration — Prisma cannot express it); a DB trigger refuses UPDATE and DELETE; whole
/// months are dropped only by the retention job after AUDIT_RETENTION_MONTHS (D-067).
model AuditLog {
  id           BigInt   @default(autoincrement())
  agencyId     String   @map("agency_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String?  @map("resource_type") @db.VarChar(100)
  resourceId   String?  @map("resource_id") @db.Uuid
  details      Json?
  ipAddress    String?  @map("ip_address") @db.Inet
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([id, createdAt])
  @@index([agencyId, createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// ─────────────────────────────── Staff (§5.3) ───────────────────────────────

model StaffProfile {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  agencyId            String    @map("agency_id") @db.Uuid
  employeeId          String?   @map("employee_id") @db.VarChar(50)
  /// Job role (care_worker, team_leader, …; @alora/shared DISCIPLINES).
  discipline          String    @db.VarChar(20)
  hireDate            DateTime? @map("hire_date") @db.Date
  /// Contracted working days a week (S3-03), for statutory holiday (5.6 weeks, max 28 days). Null = 5.
  daysPerWeek         Decimal?  @map("days_per_week") @db.Decimal(3, 1)
  /// Holiday days a full leave year, set by the office: irregular hours, or a contract above statutory. Null = statutory.
  holidayDaysOverride Decimal?  @map("holiday_days_override") @db.Decimal(4, 1)
  terminationDate     DateTime? @map("termination_date") @db.Date
  employmentType      String    @default("full_time") @map("employment_type") @db.VarChar(20)
  hourlyRate          Decimal?  @map("hourly_rate") @db.Decimal(10, 2)
  overtimeRate        Decimal?  @map("overtime_rate") @db.Decimal(10, 2)
  /// Pounds per mile, e.g. 0.45.
  mileageRate         Decimal?  @map("mileage_rate") @db.Decimal(6, 4)
  /// National Insurance number, encrypted (PhiContext.StaffNiNumber); only the last characters are ever returned.
  niNumberEncrypted   Bytes?    @map("ni_number_encrypted")
  dateOfBirth         DateTime? @map("date_of_birth") @db.Date
  addressLine1        String?   @map("address_line1") @db.VarChar(255)
  addressLine2        String?   @map("address_line2") @db.VarChar(255)
  town                String?   @db.VarChar(100)
  postcode            String?   @db.VarChar(10)
  emergencyContactName         String? @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactPhone        String? @map("emergency_contact_phone") @db.VarChar(20)
  emergencyContactRelationship String? @map("emergency_contact_relationship") @db.VarChar(50)
  /// Has a licence and car they can use for work (insurance is tracked as a check).
  canDrive            Boolean   @default(false) @map("can_drive")
  skills              String[]
  languages           String[]
  gender              String?   @db.VarChar(10)
  notes               String?
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency             Agency                       @relation(fields: [agencyId], references: [id])
  credentials        StaffCredential[]
  trainingCompletions TrainingCompletion[]
  careCertificate    CareCertificateSignOff[]
  supervisions       Supervision[]
  availability       StaffAvailability[]
  timeOff            StaffTimeOff[]
  documents          Document[]
  rightToWorkChecks  RightToWorkCheck[]
  dbsChecks          DbsCheck[]
  signatureRequests  SignatureRequest[]
  healthDeclaration  HealthDeclaration?

  @@unique([agencyId, employeeId])
  @@index([agencyId])
  @@index([agencyId, discipline])
  @@map("staff_profiles")
}

model StaffCredential {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffProfileId   String    @map("staff_profile_id") @db.Uuid
  credentialType   String    @map("credential_type") @db.VarChar(100)
  credentialName   String    @map("credential_name") @db.VarChar(255)
  credentialNumber String?   @map("credential_number") @db.VarChar(100)
  issuingAuthority String?   @map("issuing_authority") @db.VarChar(255)
  issueDate        DateTime? @map("issue_date") @db.Date
  expiryDate       DateTime? @map("expiry_date") @db.Date
  status           String    @default("active") @db.VarChar(20)
  documentId       String?   @map("document_id") @db.Uuid
  alertDaysBefore  Int       @default(30) @map("alert_days_before")
  /// Last expiry alert sent: due | week | expired. Cleared when the expiry date changes (D-062).
  expiryAlertStage String?   @map("expiry_alert_stage") @db.VarChar(10)
  verifiedById     String?   @map("verified_by") @db.Uuid
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  document     Document?    @relation(fields: [documentId], references: [id])
  verifiedBy   User?        @relation("CredentialVerifiedBy", fields: [verifiedById], references: [id])

  @@index([staffProfileId])
  @@index([expiryDate])
  @@map("staff_credentials")
}

model StaffAvailability {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffProfileId String    @map("staff_profile_id") @db.Uuid
  dayOfWeek      Int       @map("day_of_week") @db.SmallInt // 0 = Sunday
  startTime      DateTime  @map("start_time") @db.Time(6)
  endTime        DateTime  @map("end_time") @db.Time(6)
  isAvailable    Boolean   @default(true) @map("is_available")
  effectiveDate  DateTime? @map("effective_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([staffProfileId])
  @@map("staff_availability")
}

model StaffTimeOff {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffProfileId String   @map("staff_profile_id") @db.Uuid
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  type           String   @db.VarChar(20)
  /// Working days it uses (S3-03): counted on their availability pattern, or entered (half days). Null = not counted (older rows).
  days           Decimal? @db.Decimal(4, 1)
  status         String   @default("pending") @db.VarChar(20)
  approvedById   String?  @map("approved_by") @db.Uuid
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation("TimeOffApprovedBy", fields: [approvedById], references: [id])

  @@index([staffProfileId])
  @@map("staff_time_off")
}

// ─────────────────────────────── Documents & notifications (§5.8, core subset) ───────────────────────────────

model Document {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId          String    @map("agency_id") @db.Uuid
  staffId           String?   @map("staff_id") @db.Uuid
  uploadedById      String    @map("uploaded_by") @db.Uuid
  documentType      String    @map("document_type") @db.VarChar(50)
  title             String    @db.VarChar(255)
  description       String?
  fileName          String    @map("file_name") @db.VarChar(255)
  fileSize          Int?      @map("file_size")
  mimeType          String?   @map("mime_type") @db.VarChar(100)
  s3Key             String    @map("s3_key") @db.VarChar(500)
  s3VersionId       String?   @map("s3_version_id") @db.VarChar(100)
  isSigned          Boolean   @default(false) @map("is_signed")
  signatureData     Json?     @map("signature_data")
  isFaxed           Boolean   @default(false) @map("is_faxed")
  faxedTo           String?   @map("faxed_to") @db.VarChar(20)
  faxedAt           DateTime? @map("faxed_at") @db.Timestamptz(6)
  tags              String[]
  /// SHA-256 of the file as uploaded (tamper evidence; recorded in e-signatures).
  contentHash       String?   @map("content_hash") @db.VarChar(64)
  /// 1 for the first upload; a new version points at the one it replaces (D-056).
  version           Int       @default(1)
  previousVersionId String?   @unique @map("previous_version_id") @db.Uuid
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById       String?   @map("deleted_by") @db.Uuid
  deleteReason      String?   @map("delete_reason")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency          Agency            @relation(fields: [agencyId], references: [id])
  staff           StaffProfile?     @relation(fields: [staffId], references: [id])
  uploadedBy      User              @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  credentials     StaffCredential[]
  blob            DocumentBlob?
  previousVersion Document?         @relation("DocumentVersions", fields: [previousVersionId], references: [id])
  nextVersion     Document?         @relation("DocumentVersions")
  deletedBy       User?             @relation("DocumentDeletedBy", fields: [deletedById], references: [id])
  messages        Message[]

  @@index([agencyId, documentType])
  @@index([staffId])
  @@map("documents")
  signatureRequests SignatureRequest[]
}

/// A document's file, encrypted (AES-256-GCM, bound to the document id) — the database storage driver (D-056).
/// Replaced by object storage (S3 + BAA) at go-live; the storage interface hides which one is used.
model DocumentBlob {
  documentId String   @id @map("document_id") @db.Uuid
  content    Bytes
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_blobs")
}

model Notification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId       String    @map("agency_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String    @db.VarChar(50)
  title          String    @db.VarChar(255)
  body           String?
  data           Json?
  channels       String[]
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  sentViaPush    Boolean   @default(false) @map("sent_via_push")
  sentViaSms     Boolean   @default(false) @map("sent_via_sms")
  sentViaEmail   Boolean   @default(false) @map("sent_via_email")
  deliveryStatus Json?     @map("delivery_status")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agency     Agency                 @relation(fields: [agencyId], references: [id])
  user       User                   @relation(fields: [userId], references: [id])
  deliveries NotificationDelivery[]

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([agencyId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ─────────────────────────────── Messaging, notifications, training ───────────────────────────────

/// Secure messaging (DECISIONS D-057). A conversation between agency users.
model Conversation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId      String    @map("agency_id") @db.Uuid
  /// direct (two people) | group
  type          String    @default("direct") @db.VarChar(20)
  subject       String?   @db.VarChar(255)
  createdById   String    @map("created_by") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency       Agency                    @relation(fields: [agencyId], references: [id])
  createdBy    User                      @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@index([agencyId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(6)
  /// Set when the person leaves a group; they keep read access to what was said before.
  leftAt         DateTime? @map("left_at") @db.Timestamptz(6)
  isMuted        Boolean   @default(false) @map("is_muted")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

/// Message text is PHI: stored encrypted, bound to the message ID (PhiCryptoService.encryptBytes).
model Message {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId         String   @map("agency_id") @db.Uuid
  conversationId   String   @map("conversation_id") @db.Uuid
  senderId         String   @map("sender_id") @db.Uuid
  contentEncrypted Bytes    @map("content_encrypted")
  isUrgent         Boolean  @default(false) @map("is_urgent")
  /// An attached document (already uploaded through /documents).
  documentId       String?  @map("document_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agency       Agency       @relation(fields: [agencyId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])
  document     Document?    @relation(fields: [documentId], references: [id])

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

/// Per-user notification choices (DECISIONS D-066). A row exists only where the user changed the defaults (all on).
model NotificationPreference {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String  @map("user_id") @db.Uuid
  notificationType String  @map("notification_type") @db.VarChar(50)
  channelInApp     Boolean @default(true) @map("channel_in_app")
  channelPush      Boolean @default(true) @map("channel_push")
  channelSms       Boolean @default(true) @map("channel_sms")
  channelEmail     Boolean @default(true) @map("channel_email")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType])
  @@map("notification_preferences")
}

/// Outbox for push / SMS / email: one row per notification and outside channel, sent by the delivery job with
/// retries (D-071). No message text here — it's the notification's (PHI-free) title and body.
model NotificationDelivery {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String    @map("notification_id") @db.Uuid
  /// push | sms | email
  channel           String    @db.VarChar(10)
  /// pending | sending | sent | failed | skipped
  status            String    @default("pending") @db.VarChar(10)
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  /// When a job instance took the row (a row stuck in "sending" is taken again after a while).
  claimedAt         DateTime? @map("claimed_at") @db.Timestamptz(6)
  /// Provider error code/summary — never message text or contact details.
  lastError         String?   @map("last_error") @db.VarChar(300)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(100)
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

/// Phones signed in to the mobile app that can receive push notifications (Expo push tokens, D-071).
model PushDevice {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// ExponentPushToken[…] — one phone; moves to whoever signed in on it last.
  token      String   @unique @db.VarChar(255)
  /// ios | android
  platform   String   @db.VarChar(10)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

/// "Forgot password" links (D-072): single use, 30 minutes. Only a SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Primordial Academy (D-102): a short training module with a quiz. Passing can record a credential.
model TrainingCourse {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId        String   @map("agency_id") @db.Uuid
  title           String   @db.VarChar(200)
  summary         String?  @db.VarChar(500)
  /// The lesson, as plain text with blank lines between paragraphs.
  content         String
  /// Disciplines it is for (e.g. HHA, CNA); empty = everyone.
  disciplines     String[]
  /// Pass mark, percent of questions right.
  passPercent     Int      @default(80) @map("pass_percent")
  /// When set, passing records a credential of this type (e.g. infection_control).
  credentialType  String?  @map("credential_type") @db.VarChar(100)
  /// How long that credential lasts; null = no expiry.
  validityMonths  Int?     @map("validity_months")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency      Agency               @relation(fields: [agencyId], references: [id])
  questions   TrainingQuestion[]
  completions TrainingCompletion[]

  @@index([agencyId, isActive])
  @@map("training_courses")
}

model TrainingQuestion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  sortOrder    Int      @map("sort_order")
  prompt       String   @db.VarChar(1000)
  options      String[]
  /// Index into options of the right answer. Never sent to people taking the quiz.
  correctIndex Int      @map("correct_index")

  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, sortOrder])
  @@map("training_questions")
}

/// One attempt at a course's quiz.
model TrainingCompletion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId       String   @map("course_id") @db.Uuid
  staffProfileId String   @map("staff_profile_id") @db.Uuid
  scorePercent   Int      @map("score_percent")
  passed         Boolean
  /// The credential recorded for a pass, when the course grants one.
  credentialId   String?  @map("credential_id") @db.Uuid
  completedAt    DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile   @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([staffProfileId, courseId, completedAt])
  @@index([courseId])
  @@map("training_completions")
}

/// A job advert (S1-04). Open adverts appear on the company's public careers page.
model JobPosting {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId       String    @map("agency_id") @db.Uuid
  title          String    @db.VarChar(150)
  /// Job role (@alora/shared DISCIPLINES); a hire gets this on their staff record.
  discipline     String    @db.VarChar(20)
  employmentType String    @default("full_time") @map("employment_type") @db.VarChar(20)
  /// Where the work is, as shown to applicants, e.g. "Manchester (M14)".
  location       String    @db.VarChar(150)
  payFrom        Decimal?  @map("pay_from") @db.Decimal(10, 2)
  payTo          Decimal?  @map("pay_to") @db.Decimal(10, 2)
  /// hour | year
  payPeriod      String    @default("hour") @map("pay_period") @db.VarChar(10)
  /// e.g. "20 to 37.5 hours a week, days and weekends".
  hours          String?   @db.VarChar(150)
  summary        String?   @db.VarChar(300)
  description    String
  /// draft | open | closed
  status         String    @default("draft") @db.VarChar(10)
  closesOn       DateTime? @map("closes_on") @db.Date
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency       Agency        @relation(fields: [agencyId], references: [id])
  applications Application[]

  @@index([agencyId, status])
  @@map("job_postings")
}

/// A job application from the public careers page (S1-04), moved through the pipeline in S1-05.
/// Personal data (UK GDPR): never logged; deleted on the retention schedule once recruitment ends.
model Application {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId              String    @map("agency_id") @db.Uuid
  /// Null for a general ("any suitable role") application.
  jobPostingId          String?   @map("job_posting_id") @db.Uuid
  /// Short reference shown to the applicant, e.g. "A7K2-9QXD".
  reference             String    @unique @db.VarChar(12)
  firstName             String    @map("first_name") @db.VarChar(100)
  lastName              String    @map("last_name") @db.VarChar(100)
  email                 String    @db.VarChar(255)
  phone                 String    @db.VarChar(20)
  addressLine1          String?   @map("address_line1") @db.VarChar(255)
  town                  String?   @db.VarChar(100)
  postcode              String    @db.VarChar(10)
  /// @alora/shared RIGHT_TO_WORK_ANSWERS (self-declared; the real check happens at onboarding).
  rightToWork           String    @map("right_to_work") @db.VarChar(30)
  canDrive              Boolean   @default(false) @map("can_drive")
  earliestStart         DateTime? @map("earliest_start") @db.Date
  availability          String?   @db.VarChar(500)
  coverNote             String?   @map("cover_note")
  /// @alora/shared APPLICATION_STAGES
  stage                 String    @default("applied") @db.VarChar(20)
  stageChangedAt        DateTime  @default(now()) @map("stage_changed_at") @db.Timestamptz(6)
  /// e.g. "careers_page", "indeed", "referral".
  source                String?   @db.VarChar(50)
  declarationAcceptedAt DateTime  @map("declaration_accepted_at") @db.Timestamptz(6)
  /// Set when the applicant is hired: their new login (S1-05).
  hiredUserId           String?   @unique @map("hired_user_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency     Agency                  @relation(fields: [agencyId], references: [id])
  jobPosting JobPosting?             @relation(fields: [jobPostingId], references: [id])
  history    ApplicationHistory[]
  referees   ApplicationReferee[]
  events     ApplicationEvent[]
  interviews Interview[]
  referenceRequests ReferenceRequest[]

  @@index([agencyId, stage])
  @@index([agencyId, createdAt])
  @@index([jobPostingId])
  @@map("applications")
}

/// Employment history (CQC Schedule 3): jobs and explained gaps.
model ApplicationHistory {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId    String    @map("application_id") @db.Uuid
  position         Int
  /// job | gap
  kind             String    @db.VarChar(5)
  employer         String?   @db.VarChar(200)
  jobTitle         String?   @map("job_title") @db.VarChar(150)
  startDate        DateTime  @map("start_date") @db.Date
  /// Null = current job.
  endDate          DateTime? @map("end_date") @db.Date
  reasonForLeaving String?   @map("reason_for_leaving") @db.VarChar(500)
  /// Worked with children or vulnerable adults (Schedule 3 asks why that work ended).
  wasCareRole      Boolean   @default(false) @map("was_care_role")
  /// For gaps: what they were doing.
  explanation      String?   @db.VarChar(1000)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_history")
}

/// Referees given on the application; requests go out in S2-03.
model ApplicationReferee {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String  @map("application_id") @db.Uuid
  position      Int
  name          String  @db.VarChar(200)
  organisation  String? @db.VarChar(200)
  /// e.g. "Line manager at Sunrise Care".
  relationship  String  @db.VarChar(150)
  email         String  @db.VarChar(255)
  phone         String? @db.VarChar(20)
  /// May we contact them before an offer?
  contactBeforeOffer Boolean @default(false) @map("contact_before_offer")

  application Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requests    ReferenceRequest[]

  @@index([applicationId])
  @@map("application_referees")
}

/// The application's timeline (S1-05): stage changes, notes and emails sent. Append-only.
model ApplicationEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  /// stage | note | email | interview
  kind          String   @db.VarChar(20)
  fromStage     String?  @map("from_stage") @db.VarChar(20)
  toStage       String?  @map("to_stage") @db.VarChar(20)
  /// Note text, email subject, or a short description.
  text          String?
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("application_events")
}

/// An interview booked for an application (S1-05).
model Interview {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId   String   @map("application_id") @db.Uuid
  agencyId        String   @map("agency_id") @db.Uuid
  startsAt        DateTime @map("starts_at") @db.Timestamptz(6)
  durationMinutes Int      @default(30) @map("duration_minutes")
  /// in_person | video | phone
  mode            String   @default("in_person") @db.VarChar(10)
  /// Address, video link or phone number, as told to the applicant.
  location        String?  @db.VarChar(500)
  interviewerId   String?  @map("interviewer_id") @db.Uuid
  /// scheduled | completed | cancelled | no_show
  status          String   @default("scheduled") @db.VarChar(12)
  /// 1 (poor) to 5 (excellent)
  score           Int?
  /// pass | fail
  outcome         String?  @db.VarChar(10)
  notes           String?
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([agencyId, startsAt])
  @@map("interviews")
}

/// A Right to Work check (S2-01): who checked, when, how, and what it showed. Append-only — a new check is a new row.
/// A passed check also updates the staff member's `right_to_work` credential, so follow-ups use the expiry alerts.
model RightToWorkCheck {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId            String    @map("agency_id") @db.Uuid
  staffProfileId      String    @map("staff_profile_id") @db.Uuid
  /// share_code | manual_document | idsp
  method              String    @db.VarChar(20)
  /// Share code used for the online check (9 characters, no spaces).
  shareCode           String?   @map("share_code") @db.VarChar(9)
  /// Manual checks: @alora/shared RTW_DOCUMENTS key.
  documentType        String?   @map("document_type") @db.VarChar(50)
  /// Manual checks: originals seen in_person | video_call.
  seenHow             String?   @map("seen_how") @db.VarChar(12)
  /// unlimited | time_limited
  permission          String    @db.VarChar(15)
  permissionExpiresOn DateTime? @map("permission_expires_on") @db.Date
  /// When the next check is due (null = none needed).
  followUpOn          DateTime? @map("follow_up_on") @db.Date
  /// e.g. "Student: 20 hours a week in term time".
  restrictions        String?   @db.VarChar(500)
  /// passed | failed
  outcome             String    @db.VarChar(10)
  checkedOn           DateTime  @map("checked_on") @db.Date
  checkedById         String    @map("checked_by_id") @db.Uuid
  /// Evidence: the saved copy of the check or documents (a staff document).
  documentId          String?   @map("document_id") @db.Uuid
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([staffProfileId, checkedOn])
  @@index([agencyId, followUpOn])
  @@map("right_to_work_checks")
}

/// A DBS certificate (S2-02). Number, date, level and result only: never a copy, never what it says (DBS code of
/// practice). The newest certificate drives the `dbs_enhanced` credential.
model DbsCheck {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId          String    @map("agency_id") @db.Uuid
  staffProfileId    String    @map("staff_profile_id") @db.Uuid
  certificateNumber String    @map("certificate_number") @db.VarChar(12)
  issueDate         DateTime  @map("issue_date") @db.Date
  /// @alora/shared DBS_LEVELS
  level             String    @db.VarChar(30)
  /// clear | information
  result            String    @db.VarChar(12)
  /// For "information": a manager's risk-assessment decision, approved | not_approved.
  decision          String?   @db.VarChar(12)
  decidedById       String?   @map("decided_by_id") @db.Uuid
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz(6)
  updateService     Boolean   @default(false) @map("update_service")
  /// A status check reported new information: this certificate no longer counts.
  statusChanged     Boolean   @default(false) @map("status_changed")
  /// Next status check (Update Service) or new check.
  nextDueOn         DateTime  @map("next_due_on") @db.Date
  recordedById      String    @map("recorded_by_id") @db.Uuid
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  staffProfile StaffProfile     @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  statusChecks DbsStatusCheck[]

  @@index([staffProfileId, issueDate])
  @@index([agencyId, nextDueOn])
  @@map("dbs_checks")
}

/// An Update Service status check on a certificate (S2-02).
model DbsStatusCheck {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dbsCheckId  String   @map("dbs_check_id") @db.Uuid
  checkedOn   DateTime @map("checked_on") @db.Date
  /// no_change | new_information
  result      String   @db.VarChar(16)
  checkedById String   @map("checked_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dbsCheck DbsCheck @relation(fields: [dbsCheckId], references: [id], onDelete: Cascade)

  @@index([dbsCheckId])
  @@map("dbs_status_checks")
}

/// A reference request to one referee (S2-03): a one-time link to a short form; the answers land here.
model ReferenceRequest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId        String    @map("agency_id") @db.Uuid
  applicationId   String    @map("application_id") @db.Uuid
  refereeId       String    @map("referee_id") @db.Uuid
  /// SHA-256 of the link token; the token itself is only ever in the email / link.
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  /// sent | received | declined | cancelled
  status          String    @default("sent") @db.VarChar(10)
  sentAt          DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  sentById        String    @map("sent_by_id") @db.Uuid
  emailSent       Boolean   @default(false) @map("email_sent")
  respondedAt     DateTime? @map("responded_at") @db.Timestamptz(6)
  /// The referee's answers (see ReferenceAnswers in the API).
  answers         Json?
  verifiedById    String?   @map("verified_by_id") @db.Uuid
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(6)
  /// How it was verified, e.g. "Phoned the care home switchboard and spoke to the referee".
  verificationNote String?  @map("verification_note") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  referee     ApplicationReferee @relation(fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("reference_requests")
}

/// A document sent to one person to sign (S2-04): their contract, or a company policy many people sign.
model SignatureRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId       String    @map("agency_id") @db.Uuid
  documentId     String    @map("document_id") @db.Uuid
  staffProfileId String    @map("staff_profile_id") @db.Uuid
  requestedById  String    @map("requested_by_id") @db.Uuid
  requestedAt    DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  dueOn          DateTime? @map("due_on") @db.Date
  /// pending | signed | cancelled
  status         String    @default("pending") @db.VarChar(10)
  signedAt       DateTime? @map("signed_at") @db.Timestamptz(6)
  /// The name they typed to sign.
  signedName     String?   @map("signed_name") @db.VarChar(200)
  /// SHA-256 of exactly the file they signed.
  contentHash    String?   @map("content_hash") @db.VarChar(64)
  ip             String?   @db.VarChar(64)
  userAgent      String?   @map("user_agent") @db.VarChar(255)

  document     Document     @relation(fields: [documentId], references: [id])
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([staffProfileId, status])
  @@index([documentId])
  @@map("signature_requests")
}

/// A set of company documents every new starter in some job roles must sign (S2-04). Sent automatically on hire.
model OnboardingPack {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId    String   @map("agency_id") @db.Uuid
  name        String   @db.VarChar(150)
  /// Job roles it applies to; empty = everyone.
  disciplines String[]
  documentIds String[] @map("document_ids") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([agencyId])
  @@map("onboarding_packs")
}

/// Health declaration (S2-05). Special category data: answers and the review note are encrypted; only the person and
/// health:read holders can read them. One per person (a resubmission replaces it and waits for a new review).
model HealthDeclaration {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId            String    @map("agency_id") @db.Uuid
  staffProfileId      String    @unique @map("staff_profile_id") @db.Uuid
  /// AES-256-GCM, context health_declarations.answers.
  answersEncrypted    Bytes     @map("answers_encrypted")
  submittedAt         DateTime  @map("submitted_at") @db.Timestamptz(6)
  /// fit | fit_with_adjustments | occupational_health
  outcome             String?   @db.VarChar(25)
  reviewedById        String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(6)
  /// AES-256-GCM, context health_declarations.review_note.
  reviewNoteEncrypted Bytes?    @map("review_note_encrypted")
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@map("health_declarations")
}

/// One Care Certificate standard signed off for a staff member by an assessor (S3-02). Fake data only in seeds.
model CareCertificateSignOff {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId       String   @map("agency_id") @db.Uuid
  staffProfileId String   @map("staff_profile_id") @db.Uuid
  /// 1–16, see CARE_CERTIFICATE_STANDARDS in @alora/shared.
  standard       Int      @db.SmallInt
  completedOn    DateTime @map("completed_on") @db.Date
  /// Null only if the assessor's account was later deleted.
  signedOffById  String?  @map("signed_off_by") @db.Uuid
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  signedOffBy  User?        @relation("CareCertificateSignedOffBy", fields: [signedOffById], references: [id], onDelete: SetNull)

  @@unique([staffProfileId, standard])
  @@index([agencyId])
  @@map("care_certificate_sign_offs")
}

/// A supervision, appraisal or spot check (S3-04): booked, then recorded. Notes are encrypted (HR-confidential).
model Supervision {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId              String    @map("agency_id") @db.Uuid
  staffProfileId        String    @map("staff_profile_id") @db.Uuid
  /// supervision | appraisal | spot_check
  type                  String    @db.VarChar(20)
  /// scheduled | completed | cancelled
  status                String    @default("scheduled") @db.VarChar(20)
  scheduledFor          DateTime? @map("scheduled_for") @db.Date
  heldOn                DateTime? @map("held_on") @db.Date
  supervisorId          String?   @map("supervisor_id") @db.Uuid
  /// What was discussed and the actions agreed. PhiCryptoService, context SupervisionNotes.
  notesEncrypted        Bytes?    @map("notes_encrypted")
  /// The person reads the record and confirms it, optionally with a comment (encrypted, SupervisionComment).
  acknowledgedAt        DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  staffCommentEncrypted Bytes?    @map("staff_comment_encrypted")
  /// Day-before reminder sent (claimed with a guarded update).
  reminderSentAt        DateTime? @map("reminder_sent_at") @db.Timestamptz(6)
  createdById           String?   @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  supervisor   User?        @relation("SupervisionSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)

  @@index([agencyId, status])
  @@index([staffProfileId, type])
  @@map("supervisions")
}

/// "Overdue" alerts already sent, one per person, type and due date, so the daily job alerts once (S3-04).
model SupervisionOverdueAlert {
  staffProfileId String   @map("staff_profile_id") @db.Uuid
  type           String   @db.VarChar(20)
  dueOn          DateTime @map("due_on") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([staffProfileId, type, dueOn])
  @@map("supervision_overdue_alerts")
}
